---
interface Props { country:'be'|'cn' }
const { country } = Astro.props;
const star = Array.from({length:10},(_,i)=>{
  const angle=-Math.PI/2+i*Math.PI/5;
  const radius=i%2===0?1:.382;
  return `${(Math.cos(angle)*radius).toFixed(4)},${(Math.sin(angle)*radius).toFixed(4)}`;
}).join(' ');
const smallStars = [[10,2],[12,4],[12,7],[10,9]];
---
<svg class="country-flag" viewBox="0 0 30 20" width="24" height="16" aria-hidden="true">
  {country==='be' ? <><path fill="#171717" d="M0 0h10v20H0z"/><path fill="#FDDA24" d="M10 0h10v20H10z"/><path fill="#EF3340" d="M20 0h10v20H20z"/></> : <><path fill="#DE2910" d="M0 0h30v20H0z"/><g fill="#FFDE00"><polygon points={star} transform="translate(5 5) scale(3)"/>{smallStars.map(([x,y])=><polygon points={star} transform={`translate(${x} ${y}) rotate(${Math.atan2(5-y,5-x)*180/Math.PI+90})`} />)}</g></>}
</svg>
