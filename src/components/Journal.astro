---
import { sitePath } from '../lib/url';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { copy, identity, chapters, skills, employers, type Locale } from '../i18n/content';
import Links from './Links.astro';
import Figure from './Figure.astro';
import SectionHead from './SectionHead.astro';
import Plate from './Plate.astro';
import Icon from './Icon.astro';
import PhoneLinks from './PhoneLinks.astro';
import CvIcon from './CvIcon.astro';
import PrivacyMeta from './PrivacyMeta.astro';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/main.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const wordmark = readFileSync(resolve(process.cwd(), 'public/assets/brand/wordmark.svg'), 'utf8');
const base = Astro.site || new URL('http://localhost:4321');
const canonical = new URL(sitePath(`/${locale}/`), base).href;
const schema = { '@context':'https://schema.org', '@type':'Person', name:identity.name, alternateName:identity.chineseName, url:canonical, jobTitle:'Engineer, Guitarist & Art Director', knowsAbout:['Electronics','Software engineering','Artificial intelligence','Art direction'], affiliation:[{'@type':'Organization',name:'KU Leuven'},{'@type':'MusicGroup',name:'Slow Erosion'}], sameAs:[identity.linkedin, identity.github] };
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8" />
  <PrivacyMeta />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&(!location.hash||location.hash==='#top')){document.documentElement.classList.add('will-write');setTimeout(()=>document.documentElement.classList.remove('will-write'),4000);}</script>
  <meta name="theme-color" content="#0C0D10" /><title>{t.title}</title><meta name="description" content={t.description} />
  <link rel="canonical" href={canonical} /><link rel="alternate" hreflang="en" href={new URL(sitePath('/en/'),base).href} /><link rel="alternate" hreflang="zh-CN" href={new URL(sitePath('/zh/'),base).href} /><link rel="alternate" hreflang="x-default" href={new URL(sitePath('/en/'),base).href} />
  <meta property="og:type" content="website" /><meta property="og:title" content={t.title} /><meta property="og:description" content={t.description} /><meta property="og:url" content={canonical} /><meta property="og:locale" content={locale==='en'?'en_GB':'zh_CN'} /><meta property="og:image" content={new URL(sitePath(`/assets/brand/og-${locale}.jpg`),base).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={sitePath('/assets/brand/portrait-cutout.svg')} type="image/svg+xml" /><link rel="icon" href={sitePath('/assets/brand/portrait-cutout-32.png')} type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href={sitePath('/assets/brand/portrait-cutout-180.png')} />
  <link rel="preload" as="image" href={sitePath('/assets/brand/ink-photo.webp')} media="(min-width:701px)" fetchpriority="high" />
  <link rel="preload" as="image" href={sitePath('/assets/brand/ink-photo-mobile.webp')} media="(max-width:700px)" fetchpriority="high" />
  {locale === 'zh' && <link rel="stylesheet" href={sitePath('/assets/brand/zh-fonts.css')} />}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body data-locale={locale}>
  <a class="skip-link" href="#abstract">{t.skip}</a>
  <svg class="filter-defs" aria-hidden="true"><defs><filter id="ink-bleed" x="-5%" y="-10%" width="110%" height="120%"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="7" result="noise" /><feDisplacementMap in="SourceGraphic" in2="noise" scale="1.3" xChannelSelector="R" yChannelSelector="G" /><feGaussianBlur stdDeviation=".12" /></filter><filter id="tidal-refraction" x="-20%" y="-30%" width="140%" height="160%" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency=".008 .024" numOctaves="2" seed="12" result="liquid"/><feDisplacementMap id="tide-displacement" in="SourceGraphic" in2="liquid" scale="0" xChannelSelector="R" yChannelSelector="B"/></filter></defs></svg>
  <header class="running-head">
    <a class="home-mark" href="#top" aria-label="Shay Chen / 陈乐涵"><img src={sitePath('/assets/brand/portrait-cutout-128.webp')} width="44" height="44" alt="" /><span>SHAY CHEN</span></a>
    <span class="running-section mono" aria-live="off">ENGINEER & GUITARIST</span>
    <div class="header-actions">
      <nav class="language mono" aria-label={locale==='en'?'Language':'语言'}><a href={sitePath('/en/')} lang="en" data-language="en" aria-current={locale==='en'?'page':undefined}>EN</a><span aria-hidden="true">/</span><a href={sitePath('/zh/')} lang="zh-CN" data-language="zh" aria-current={locale==='zh'?'page':undefined}>中</a></nav>
      <details id="site-index" class="site-index"><summary class="mono">{t.index}<span class="index-symbol" aria-hidden="true">＋</span></summary>
        <nav class="index-panel" aria-label={t.contents}>
          <div class="index-inner"><p class="mono">SHAY CHEN / {t.journal}</p><h2>{t.contents}</h2><ol>{chapters.map((id,i)=><li><a href={`#${id}`}><span class="mono">§ {i.toString().padStart(2,'0')}</span><span>{t.nav[i]}</span><span class="mono">{(i+1).toString().padStart(2,'0')}</span></a></li>)}</ol><p class="index-colophon mono">{t.edition} · {t.location}</p></div>
        </nav>
      </details>
    </div>
    <div class="reading-progress" aria-hidden="true"></div>
  </header>
  <main>
    <div class="opening-sequence">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="ink-scene" aria-hidden="true"><picture><source media="(max-width:700px)" srcset={sitePath('/assets/brand/ink-photo-mobile.webp')}/><img class="hero-poster" src={sitePath('/assets/brand/ink-photo.webp')} width="1672" height="941" alt="" fetchpriority="high"/></picture><canvas id="ink-canvas"></canvas></div>
      <div class="hero-photo hero-photo-portrait" aria-hidden="true"><img src={sitePath('/assets/img/portrait-1280.webp')} width="1280" height="1600" alt="" loading="lazy" /></div>
      <div class="hero-photo hero-photo-nice" aria-hidden="true"><img src={sitePath('/assets/img/nice-1280.webp')} width="1280" height="1600" alt="" loading="lazy" /></div>
      <div class="hero-top mono"><span>{t.journal}</span><span>{t.edition}</span></div>
      <div class="hero-center">
        <p class="hero-kicker mono"><span class="tiny-rule"></span> ENGINEERING <span class="hero-and">&</span> MUSIC <span class="tiny-rule"></span></p>
        <div class="name-stage">
          <h1 id="hero-title"><span class="sr-only">Shay Chen · 陈乐涵</span><span class="hero-wordmark" aria-hidden="true" set:html={wordmark} /></h1>
          <div class="name-hover-zones"><button class="name-zone" data-portrait="portrait" aria-label={locale==='en'?'Show portrait of Shay Chen':'查看陈乐涵的肖像'} aria-pressed="false"></button><button class="name-zone" data-portrait="nice" aria-label={locale==='en'?'Show Shay in Nice':'查看陈乐涵在尼斯的照片'} aria-pressed="false"></button></div>
        </div>
        <div class="hero-role"><p>{t.role}</p><a class="hero-cv" href={identity.cv} download aria-label={t.cv}><CvIcon/></a></div>
        <p class="hero-name">{identity.chineseName}</p>
        <p class="mono hero-location hero-location-center">{t.location}</p>
      </div>
      <div class="hero-bottom"><div><Links t={t} hero /><div class="hero-direct mono"><a href={`mailto:${identity.email}`}>{identity.email}</a><PhoneLinks locale={locale}/></div></div><a class="scroll-cue mono" href="#abstract"><span>{t.scroll}</span><span aria-hidden="true">↓</span></a></div>
      <div class="tide-aperture" aria-hidden="true"></div>
      <div class="tide-caption" aria-hidden="true"><span class="mono">00 / {t.nav[0]}</span><span class="tide-caption-line"></span><span class="mono">{locale === 'en' ? 'A different depth.' : '向更深处。'}</span></div>
      <span class="hero-edge mono" aria-hidden="true">墨 / INK STUDY No. 01</span>
    </section>
    </div>
    <div class="journal-body">
      <section id="abstract" class="journal-section abstract-section" data-section={t.nav[0]}>
        <div class="abstract-grid"><aside class="marginalia"><p class="mono">§ 00 / {t.nav[0]}</p><p>{t.abstractMargin}</p><span class="margin-cross" aria-hidden="true">＋</span></aside>
        <div class="abstract-copy"><h2 class="ink-heading">{t.abstractTitle}</h2><div class="lead">{t.abstract.split('\n\n').map(paragraph=><p>{paragraph}</p>)}</div><img class="signature" src={sitePath('/assets/brand/signature.svg')} alt="Shay" width="160" height="65" /></div>
        <Figure class="portrait" name="portrait" alt={t.portraitAlt} caption={t.portraitCaption} number={1} eager />
        </div>
      </section>
      <section id="engineering" class="journal-section" data-section={t.nav[1]}>
        <SectionHead n={1} title={t.engineeringTitle} abstract={t.engineeringAbstract} />
        <div class="body-grid"><aside class="marginalia"><p>{t.engineeringMargin}</p><span class="margin-cross" aria-hidden="true">＋</span></aside>
        <div class="wide-copy"><div class="experience-list">{t.experience.map((e)=>{
          const brand = employers[e.company];
          return <article class="experience" style={`--brand-color:${brand.color}`}>
            <div class="experience-date mono"><time>{e.date}</time><span>{e.place}</span></div>
            <div class="experience-content"><div class="experience-heading"><a class="experience-company" href={brand.url} target="_blank" rel="noopener noreferrer"><h3>{e.company}</h3><Icon name="arrow" size={16}/></a><img class="experience-logo" src={sitePath(`/assets/brand/${brand.logo}`)} alt={`${e.company} logo`} width="180" height="60" loading="lazy"/></div>
              <p class="job-role">{e.role}</p>{e.text && <p>{e.text}</p>}{e.stack && <p class="stack mono">{e.stack}</p>}{e.note && <p class="nda">{e.note}</p>}
            </div>
          </article>;
        })}</div><div class="education"><h3 class="education-label mono">{t.educationLabel}</h3>
          <article class="experience university" style="--brand-color:#54bceb">
            <div class="experience-date mono"><time>{locale==='en'?'2024 — present':'2024 年 — 至今'}</time><span>{locale==='en'?'Leuven, Belgium':'比利时，鲁汶'}</span></div>
            <div class="experience-content"><div class="experience-heading"><a class="experience-company" href="https://www.kuleuven.be/english/" target="_blank" rel="noopener noreferrer"><h3>KU Leuven</h3><Icon name="arrow" size={16}/></a><img class="experience-logo" src={sitePath('/assets/brand/kuleuven-logo.svg')} alt="KU Leuven logo" width="159" height="57" loading="lazy"/></div><p class="job-role">{locale==='en'?'Bachelor of Engineering Technology':'工程技术学士'}</p><p>{locale==='en'?'Electronics & ICT · In progress':'电子与 ICT · 在读'}</p></div>
          </article>
        </div></div></div>
      </section>
      <section id="works" class="journal-section" data-section={t.nav[2]}>
        <SectionHead n={2} title={t.worksTitle} abstract={t.worksAbstract} />
        <div class="works-list">{t.projects.map((project,index)=><Plate project={project} index={index} t={t} />)}</div>
        <div class="project-notes">{t.projects.map((p,i)=><details id={`project-${p.id}`} class="project-note"><summary><span class="mono">{['I','II','III'][i]}</span><span>{p.title}</span><span class="plus" aria-hidden="true">＋</span></summary><div class="project-note-body"><p class="project-description">{p.description}</p><p class="mono">{p.stack}</p><p class="project-award">{p.award}</p><p>{p.context}</p><cite>{p.citation}</cite>{p.link && <a class="text-link mono" href={p.link} target="_blank" rel="noopener noreferrer">{locale==='en'?'View project':'查看项目'} ↗</a>}</div></details>)}</div>
      </section>
      <section id="recognition" class="journal-section" data-section={t.nav[3]}>
        <SectionHead n={3} title={t.recognitionTitle} abstract={t.recognitionAbstract} />
        <div class="body-grid"><aside class="marginalia"><p class="mono">2025—2026</p><p>{locale==='en'?'Two hackathons.\nTwo grand prizes.':'两场黑客松。\n两次总冠军。'}</p></aside><ol class="awards wide-copy">{t.awards.map(([year,title,context],i)=><li tabindex="0"><span class="award-year mono">{year}</span><div><h3>{i<2 ? <a href={`#project-${i===0?'data':'aqua'}`}>{title}</a> : title}</h3><p>{context}</p>{i<2 && <span class="award-project mono">{i===0?'ASK YOUR DATA / 300+ PARTICIPANTS':'AQUA SEAL / MONACO'} <Icon name="arrow" size={12}/></span>}</div><span class="award-star" aria-hidden="true">✳</span></li>)}</ol></div>
      </section>
      <section id="art" class="journal-section art-section" data-section={t.nav[4]}>
        <SectionHead n={4} title={t.artTitle} abstract={t.artAbstract} />
        <div class="art-layout"><div class="art-copy"><p class="mono">WUHAN, CN / EST. 2023</p><a class="band-logo-link" href={identity.band} target="_blank" rel="noopener noreferrer" aria-label={t.bandVisit}><img src={sitePath('/assets/brand/slow-erosion-logo.png')} width="480" height="144" alt="Slow Erosion"/><Icon name="arrow" size={20}/></a><p class="art-role mono">{t.artRole}</p><p class="band-intro">{t.bandIntro}</p><p class="art-statement">{t.artStatement}</p><p class="art-credit mono">{t.artCredit}</p><a class="text-link mono" href={identity.band} target="_blank" rel="noopener noreferrer">{t.bandVisit} <Icon name="arrow" size={14}/></a></div><Figure class="band-photo" name="band" alt={t.bandAlt} caption={t.bandCaption} number={2} /></div>
        <div class="early-stage"><div><p class="mono">{t.earlyStage}</p><h3>The Attic</h3><p class="attic-role">{t.atticRole}</p></div><div class="performance-note"><div class="audience-number" aria-hidden="true">500<span>+</span></div><div><p class="mono">{t.audience}</p><p class="attic-text">{t.atticText}</p></div></div></div>
      </section>
      <section id="notes" class="journal-section notes-section" data-section={t.nav[5]}>
        <SectionHead n={5} title={t.notesTitle} abstract={t.notesAbstract} />
        <div class="notes-layout"><div class="notes-aside"><span class="mono">NICE, FRANCE</span><p class="notes-text">{t.notesText}</p><span class="notes-coordinate mono">OFF SCREEN / ON THE COAST</span></div><Figure name="nice" alt={t.niceAlt} caption={t.niceCaption} number={3} /></div>
      </section>
      <section id="toolkit" class="journal-section" data-section={t.nav[6]}>
        <SectionHead n={6} title={t.toolkitTitle} abstract={t.toolkitAbstract} />
        <div class="toolkit-grid">{skills.map((group,i)=><div class="toolkit-group"><h3 class="mono"><span>{String.fromCharCode(65+i)}.</span> {t.skillLabels[i]}</h3><ul>{group.map(s=><li>{s}</li>)}</ul></div>)}</div>
      </section>
      <section id="contact" class="journal-section contact-section" data-section={t.nav[7]}>
        <SectionHead n={7} title={t.contactTitle} abstract={t.contactAbstract} />
        <div class="body-grid"><aside class="marginalia"><p>{t.contactMargin}</p></aside><div class="wide-copy"><p class="contact-intro">{t.contactText}</p><div class="email-row"><a href={`mailto:${identity.email}`}>{identity.email}</a><button type="button" id="copy-email" class="mono" data-email={identity.email} data-label={t.copy} data-success={t.copied} data-error={t.copyFailed} hidden>{t.copy}<span aria-hidden="true"> ⧉</span></button></div><p id="copy-status" class="mono" role="status"></p><div class="contact-phones"><PhoneLinks locale={locale}/></div><Links t={t} full /></div></div>
      </section>
    </div>
  </main>
  <footer class="footer"><div class="footer-top"><p class="closing ink-heading">{t.footerLine}</p><div class="footer-marks"><img src={sitePath('/assets/brand/signature.svg')} alt="Shay" width="160" height="65" /><img src={sitePath('/assets/brand/portrait-cutout-128.webp')} alt={locale==='en'?'Shay Chen line portrait':'陈乐涵简笔肖像'} width="58" height="58" /></div></div><Links t={t} /><div class="footer-contact mono"><a href={`mailto:${identity.email}`}><Icon name="mail" size={14}/>{identity.email}</a><PhoneLinks locale={locale}/></div><div class="colophon mono"><p>© 2026 SHAY CHEN / 陈乐涵<br/>{t.colophon}</p><p>{t.updated} {identity.updated}<br/><a href="#top">{t.top} ↑</a></p></div></footer>
  <script src="../scripts/journal.ts"></script>
</body>
</html>
